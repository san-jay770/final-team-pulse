# ============================================================
# TEAM PULSE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Session Secret (use a long random string in production)
SESSION_SECRET=teampulse-super-secret-change-in-production-2024

# ============================================================
# NODEMAILER — Gmail SMTP
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate an App Password for "Mail"
# 4. Paste it below (no spaces)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=Team Pulse

# Super Admin email — receives daily reports and system alerts
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com

# ============================================================
# CRON SCHEDULES (node-cron format: second minute hour day month weekday)
# ============================================================
# Daily morning reminder — 8:30 AM weekdays
CRON_MORNING_REMINDER=0 30 8 * * 1-5
# Overdue task check — 9:00 AM daily
CRON_OVERDUE_CHECK=0 0 9 * * *
# Due-tomorrow reminder — 5:00 PM daily
CRON_DUE_REMINDER=0 0 17 * * *
# Daily admin report — 6:00 PM daily
CRON_DAILY_REPORT=0 0 18 * * *
